#include <iostream>
#include <array>
#include <vector>
#include <cassert>
#include <algorithm>
#include <cstddef>
#include <string>
template <typename T>
void vec_fill(std::vector<T>& vec, size_t size, const T& value){// fills Vector with elements
    vec.resize(size);
    
    std::fill(vec.begin(), vec.end(), value); 
} 

void Tst_vec_fill(){
    //test 1 int
    std::vector<int> intVec;
    vec_fill(intVec,3,5);
    assert(intVec.size() ==3);
    assert(intVec[0]==5);
    assert(intVec[1]==5);
    assert(intVec[2]==5);
    //test 2 double
    std::vector<double> DoubVec;
    vec_fill(DoubVec, 2, 3.14);
    assert(DoubVec.size()==2);
    assert(DoubVec[0]==3.14);
    assert(DoubVec[1]==3.14);
    //test 3 string
    std::vector<std::string> StrVec;
    vec_fill(StrVec,4,std::string("Clear"));
    assert(StrVec.size() ==4);
    assert(StrVec[0]=="Clear");
    assert(StrVec[1]=="Clear");
    assert(StrVec[2]=="Clear");
    assert(StrVec[3]=="Clear");
    //Test confirm
    std::cout << "All tests cleared, vec_fill works!\n";
}

int main(){
    int Elem = 1;
    std::vector<int> ElemVec;
    vec_fill(ElemVec, 10, Elem); 

    for (size_t i=0; i < ElemVec.size(); ++i){
        std::cout << ElemVec[i] + i << " "; //should print Elem,Elem+1,Elem+2,etc
    }
return 0;
